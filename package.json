{
  "name": "media-workbench",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.0"
  },
  "scripts": {
    "dev": "tsx apps/server/src/main.ts",
    "start": "node dist/server/main.js",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "fixtures": "tsx packages/test-fixtures/generate.ts",
    "desktop": "electron apps/desktop/main.cjs",
    "tools:setup": "node scripts/setup-tools.mjs",
    "test:ui": "tsx tests/browser.smoke.ts",
    "test:responsive": "tsx tests/ui-responsive.smoke.ts",
    "tools:verify": "node scripts/verify-tools.mjs",
    "tools:update": "node scripts/update-ytdlp.mjs",
    "tools:rollback": "node scripts/update-ytdlp.mjs --rollback",
    "package:desktop": "npm run build && node scripts/package-desktop.mjs",
    "package:installer": "npm run package:desktop && node scripts/make-installer.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "10.1.3",
    "fastify": "5.12.5",
    "ipaddr.js": "2.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "0.25.12",
    "playwright": "1.63.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
