# Template only. The service refuses startup until the administrator supplies
# an existing verified worker image and a strong owner credential separately.
# Node does not load this file automatically; use the deployment host's protected
# environment configuration. Do not copy desktop credentials or its data folder.
MW_SHARED=1
MW_ISOLATE=1
MW_HOST=127.0.0.1
MW_PORT=4319
MW_DATA_DIR=/var/lib/media-workbench-public
MW_PUBLIC_ORIGIN=https://workbench.example.com
MW_WORKER_IMAGE=
MW_OWNER_TOKEN=
MW_TUNNEL_PROTOTYPE=0
MW_DESKTOP_SECRET=

# Caddy-only setting: an owned hostname, without scheme, path or wildcard.
MW_PUBLIC_HOST=workbench.example.com
